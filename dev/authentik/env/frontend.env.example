# Authentik / hybrid auth (frontend Vite) — copy into frontend/.env

VITE_AUTHENTIK_ENABLED=true
VITE_LEGACY_AUTH_ENABLED=true

VITE_AUTHENTIK_AUTHORITY=http://localhost:9000/application/o/dizidental-hms/
VITE_AUTHENTIK_CLIENT_ID=dizidental-hms-spa
VITE_AUTHENTIK_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_AUTHENTIK_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
VITE_AUTHENTIK_SCOPES=openid profile email offline_access hms

# Show SSO buttons on login (enable after Sources exist in Authentik)
VITE_AUTHENTIK_SSO_GOOGLE_ENABLED=false
VITE_AUTHENTIK_SSO_MICROSOFT_ENABLED=false
