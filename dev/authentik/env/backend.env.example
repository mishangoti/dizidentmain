# Copy into application-dev.properties (U4+)
# Prefer 127.0.0.1 over localhost for JWKS fetches from the JVM (avoids IPv6/timeouts).

app.authentik.enabled=true
app.auth.legacy-enabled=true

app.authentik.issuer-uri=http://127.0.0.1:9000/application/o/dizidental-hms/
app.authentik.jwk-set-uri=http://127.0.0.1:9000/application/o/dizidental-hms/jwks/
app.authentik.client-id=dizidental-hms-spa
app.authentik.audience=dizidental-hms-spa
