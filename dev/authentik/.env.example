# Copy to .env and generate secrets before first start:
#   PG_PASS=<random>
#   AUTHENTIK_SECRET_KEY=<random long string>
PG_PASS=change_me_pg_password
AUTHENTIK_SECRET_KEY=change_me_long_random_secret_key_at_least_50_chars
PG_USER=authentik
PG_DB=authentik
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443
AUTHENTIK_TAG=2026.5.6
AUTHENTIK_URL=http://localhost:9000
# Optional: Admin UI API token for scripts/setup-hms-oidc.ps1 and sync-hms-users.ps1 (never commit real token)
# AUTHENTIK_TOKEN=
# Optional HMS DB link-back for sync-hms-users.ps1 (defaults match application-dev.properties)
# HMS_DB_HOST=localhost
# HMS_DB_PORT=5432
# HMS_DB_NAME=clinic_hms
# HMS_DB_USER=postgres
# HMS_DB_PASSWORD=Admin123
# HMS_DB_SKIP=false

# Optional SSO Sources (U6) — never commit real secrets
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_SLUG=google
# ENTRA_OAUTH_CLIENT_ID=
# ENTRA_OAUTH_CLIENT_SECRET=
# ENTRA_TENANT_ID=
# ENTRA_OAUTH_SLUG=entra-id

